<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Project_Minutes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Project_Minutes.Models;assembly=Project_Minutes.Domain"
        Title="Minutas y firmas"
        Width="1120"
        Height="760"
        MinWidth="920"
        MinHeight="580"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{StaticResource Brush.Surface}">
        <Border DockPanel.Dock="Top"
                Margin="16,10,16,0"
                Style="{StaticResource PanelCard}"
                Background="{StaticResource Brush.Card}"
                Padding="0">
            <Menu Padding="14,10,14,8" Background="Transparent">
                <MenuItem Header="_Archivo">
                    <MenuItem Header="Gestionar _usuarios…" Click="MenuUsers_Click" />
                    <MenuItem Header="Registrar _administrador…" Click="MenuRegisterAdmin_Click" />
                    <Separator />
                    <MenuItem Header="_Cerrar sesión" Click="MenuLogout_Click" />
                    <Separator />
                    <MenuItem Header="_Probar conexión al servidor" Click="ReconnectButton_Click" />
                </MenuItem>
            </Menu>
        </Border>

        <Border DockPanel.Dock="Top"
                Margin="16,10,16,0"
                Style="{StaticResource PanelCard}"
                Background="{StaticResource Brush.Card}">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Minutas y firmas"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock x:Name="SessionUserText"
                               Margin="0,6,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Brush.Muted}"
                               Text="Administrador: —" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Brush.MutedLight}"
                               Text="Comprobando conexión…" />
                </StackPanel>
            </Grid>
        </Border>

        <Border DockPanel.Dock="Bottom"
                Margin="16,0,16,10"
                Style="{StaticResource InsetPanel}"
                Background="{StaticResource Brush.Panel}"
                Padding="12,8">
            <TextBlock x:Name="DataPathText"
                       FontSize="11"
                       Foreground="{StaticResource Brush.Muted}"
                       Text="Datos guardados en: —" />
        </Border>

        <TabControl Margin="16,12,16,14" x:Name="MainTabs">
            <!-- Reuniones: lista + detalle con participantes de la reunión elegida -->
            <TabItem Header="Reuniones">
                <Grid Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.36*" MinWidth="268" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Reuniones" />
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource Brush.Muted}"
                                           TextWrapping="Wrap"
                                           Text="Elige una reunión para ver y editar a los participantes en el panel derecho." />
                            </StackPanel>
                            <ListBox x:Name="MeetingsList"
                                     Grid.Row="1"
                                     Margin="0,14,0,14"
                                     Style="{StaticResource CardListBox}"
                                     SelectionMode="Single"
                                     SelectionChanged="MeetingsList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding Line}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="2"
                                    Style="{StaticResource InsetPanel}"
                                    Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Nueva reunión"
                                            Click="NewMeeting_Click"
                                            Style="{StaticResource OutlineAccentButton}" />
                                    <Button Content="Editar" Click="EditMeeting_Click" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="Eliminar" Click="DeleteMeeting_Click" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" />

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Style="{StaticResource InsetPanel}"
                                    Margin="0,0,0,14"
                                    Padding="14,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="PARTICIPANTES DE LA REUNIÓN" Margin="0,0,0,6" />
                                    <TextBlock x:Name="MeetingContextTitle"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}"
                                               TextWrapping="Wrap"
                                               Text="Selecciona una reunión" />
                                    <TextBlock x:Name="MeetingContextSubtitle"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Muted}"
                                               TextWrapping="Wrap"
                                               Text="Los asistentes registrados podrán firmar la minuta de esta reunión." />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="ParticipantsList"
                                     Grid.Row="1"
                                     Style="{StaticResource CardListBox}"
                                     SelectionMode="Single">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:ParticipantRecord}">
                                        <TextBlock FontSize="14"
                                                   Foreground="{StaticResource Brush.Text}"
                                                   Text="{Binding ListCaption}" />
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="2"
                                    Style="{StaticResource InsetPanel}"
                                    Margin="0,14,0,0"
                                    Padding="14,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="AÑADIR PARTICIPANTE" Margin="0,0,0,8" />
                                    <Grid>
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*" />
                                            <ColumnDefinition Width="*" />
                                        </Grid.ColumnDefinitions>
                                        <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                            <TextBlock Text="Nombre"
                                                       FontSize="12"
                                                       Foreground="{StaticResource Brush.Muted}"
                                                       Margin="0,0,0,4" />
                                            <TextBox x:Name="NewParticipantNameBox"
                                                     Padding="8,6"
                                                     MinHeight="32"
                                                     VerticalContentAlignment="Center" />
                                        </StackPanel>
                                        <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                            <TextBlock Text="Puesto"
                                                       FontSize="12"
                                                       Foreground="{StaticResource Brush.Muted}"
                                                       Margin="0,0,0,4" />
                                            <TextBox x:Name="NewParticipantPositionBox"
                                                     Padding="8,6"
                                                     MinHeight="32"
                                                     VerticalContentAlignment="Center" />
                                        </StackPanel>
                                    </Grid>
                                    <StackPanel Orientation="Horizontal" Margin="0,12,0,0">
                                        <Button Content="Registrar participante"
                                                Click="RegisterNewParticipant_Click"
                                                Style="{StaticResource OutlineAccentButton}" />
                                        <Button Content="Quitar de la reunión"
                                                Click="RemoveParticipant_Click"
                                                Style="{StaticResource SecondaryButton}" />
                                    </StackPanel>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Minutas: lista + detalle con compromisos de la minuta elegida -->
            <TabItem Header="Minutas">
                <Grid Margin="2,8,2,0">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="0.36*" MinWidth="268" />
                        <ColumnDefinition Width="8" />
                        <ColumnDefinition Width="*" MinWidth="340" />
                    </Grid.ColumnDefinitions>

                    <Border Grid.Column="0" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <StackPanel Grid.Row="0">
                                <TextBlock Style="{StaticResource PageTitle}" Text="Minutas" />
                                <TextBlock FontSize="12"
                                           Foreground="{StaticResource Brush.Muted}"
                                           TextWrapping="Wrap"
                                           Text="Filtra por reunión y elige una minuta para gestionar compromisos a la derecha." />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Margin="0,12,0,12">
                                <TextBlock Text="Reunión"
                                           FontSize="12"
                                           Foreground="{StaticResource Brush.Muted}"
                                           Margin="0,0,0,6" />
                                <ComboBox x:Name="MinuteFilterCombo"
                                          DisplayMemberPath="DisplayText"
                                          MinWidth="240"
                                          SelectionChanged="MinuteFilterCombo_SelectionChanged" />
                            </StackPanel>
                            <ListBox x:Name="MinutesList"
                                     Grid.Row="2"
                                     Margin="0,0,0,14"
                                     Style="{StaticResource CardListBox}"
                                     SelectionMode="Single"
                                     SelectionChanged="MinutesList_SelectionChanged">
                                <ListBox.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel>
                                            <TextBlock Text="{Binding DisplayLine}"
                                                       TextWrapping="Wrap"
                                                       FontSize="14"
                                                       FontWeight="SemiBold"
                                                       Foreground="{StaticResource Brush.Text}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="11"
                                                       Foreground="{StaticResource Brush.Muted}"
                                                       Text="{Binding CreatedAt, StringFormat=Registrada: {0:g}}" />
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="3" Style="{StaticResource InsetPanel}" Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Nueva minuta"
                                            Click="NewMinute_Click"
                                            Style="{StaticResource OutlineAccentButton}" />
                                    <Button Content="Editar" Click="EditMinute_Click" Style="{StaticResource SecondaryButton}" />
                                    <Button Content="Eliminar" Click="DeleteMinute_Click" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>

                    <GridSplitter Grid.Column="1" Width="8" HorizontalAlignment="Center" />

                    <Border Grid.Column="2" Style="{StaticResource PanelCard}">
                        <Grid>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="*" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>
                            <Border Grid.Row="0"
                                    Style="{StaticResource InsetPanel}"
                                    Margin="0,0,0,14"
                                    Padding="14,12">
                                <StackPanel>
                                    <TextBlock Style="{StaticResource SectionTitle}" Text="COMPROMISOS DE LA MINUTA" Margin="0,0,0,6" />
                                    <TextBlock x:Name="MinuteContextTitle"
                                               FontSize="16"
                                               FontWeight="SemiBold"
                                               Foreground="{StaticResource Brush.Text}"
                                               TextWrapping="Wrap"
                                               Text="Selecciona una minuta" />
                                    <TextBlock x:Name="MinuteContextSubtitle"
                                               Margin="0,6,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Muted}"
                                               TextWrapping="Wrap"
                                               Text="Acciones acordadas, responsable y firma de aceptación." />
                                </StackPanel>
                            </Border>
                            <ListBox x:Name="TasksList"
                                     Grid.Row="1"
                                     Style="{StaticResource CardListBox}">
                                <ListBox.ItemTemplate>
                                    <DataTemplate DataType="{x:Type models:TaskRecord}">
                                        <StackPanel>
                                            <TextBlock FontWeight="SemiBold"
                                                       FontSize="14"
                                                       Text="{Binding Title}" />
                                            <TextBlock Margin="0,4,0,0"
                                                       FontSize="12"
                                                       Foreground="{StaticResource Brush.Muted}"
                                                       Text="{Binding ResponsibleName, TargetNullValue=Sin responsable}" />
                                            <TextBlock FontSize="11"
                                                       Foreground="{StaticResource Brush.Muted}"
                                                       Text="{Binding DueDate, StringFormat=Fecha límite: {0:d}, TargetNullValue=Sin fecha límite}" />
                                            <TextBlock Margin="0,6,0,0"
                                                       FontSize="12"
                                                       FontWeight="SemiBold">
                                                <TextBlock.Style>
                                                    <Style TargetType="TextBlock">
                                                        <Setter Property="Text"
                                                                Value="✓ Responsable firmó (acepta responsabilidad)" />
                                                        <Setter Property="Foreground" Value="{StaticResource Brush.Success}" />
                                                        <Style.Triggers>
                                                            <DataTrigger Binding="{Binding HasResponsibleSignature}" Value="False">
                                                                <Setter Property="Text"
                                                                        Value="⚠ Falta firma del responsable" />
                                                                <Setter Property="Foreground"
                                                                        Value="{StaticResource Brush.Warning}" />
                                                            </DataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </TextBlock.Style>
                                            </TextBlock>
                                        </StackPanel>
                                    </DataTemplate>
                                </ListBox.ItemTemplate>
                            </ListBox>
                            <Border Grid.Row="2"
                                    Style="{StaticResource InsetPanel}"
                                    Margin="0,14,0,0"
                                    Padding="12,10">
                                <StackPanel Orientation="Horizontal">
                                    <Button Content="Nuevo compromiso"
                                            Click="NewTask_Click"
                                            Style="{StaticResource OutlineAccentButton}" />
                                    <Button Content="Firma del responsable…"
                                            Click="SignTask_Click"
                                            ToolTip="Solo el responsable asignado puede firmar y asumir el compromiso." />
                                    <Button Content="Eliminar" Click="DeleteTask_Click" Style="{StaticResource SecondaryButton}" />
                                </StackPanel>
                            </Border>
                        </Grid>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
