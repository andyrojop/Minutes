<Window x:Class="Project_Minutes.Dialogs.TaskSignDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Firmar compromiso"
        Width="480"
        SizeToContent="Height"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Surface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Accent}" Padding="16,12">
            <Grid>
                <TextBlock Text="Firma del responsable"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Content="✕"
                        Style="{StaticResource DialogCloseButton}"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <StackPanel Grid.Row="1" Margin="20,16,20,20">
            <TextBlock Text="Compromiso" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
            <TextBlock x:Name="TaskTitleBlock"
                       FontWeight="SemiBold"
                       TextWrapping="Wrap"
                       Margin="0,0,0,14" />

            <TextBlock Text="Responsable" Foreground="{StaticResource Brush.Muted}" Margin="0,0,0,4" />
            <TextBlock x:Name="ResponsibleBlock"
                       Margin="0,0,0,14" />

            <TextBlock TextWrapping="Wrap"
                       FontSize="12"
                       Foreground="{StaticResource Brush.Text}"
                       Margin="0,0,0,10"
                       Text="Al firmar, el responsable declara conocer el compromiso y asumir la total responsabilidad por su cumplimiento." />

            <CheckBox x:Name="AcceptCheck"
                      Margin="0,0,0,14"
                      Content="Confirmo que asumo la responsabilidad sobre este compromiso." />

            <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                <Button Content="Capturar firma del responsable" Click="Capture_Click" />
            </StackPanel>

            <Border Height="100"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="#FAFAFA"
                    Margin="0,0,0,16">
                <Image x:Name="Preview"
                       Stretch="Uniform"
                       Margin="8"
                       RenderOptions.BitmapScalingMode="HighQuality" />
            </Border>

            <StackPanel HorizontalAlignment="Right" Orientation="Horizontal">
                <Button Content="Cancelar"
                        MinWidth="100"
                        Click="Cancel_Click"
                        Style="{StaticResource SecondaryButton}" />
                <Button Content="Guardar firma"
                        MinWidth="120"
                        Click="Save_Click" />
            </StackPanel>
        </StackPanel>
    </Grid>
</Window>
