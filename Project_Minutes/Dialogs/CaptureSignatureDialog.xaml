<Window x:Class="Project_Minutes.Dialogs.CaptureSignatureDialog"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:wfi="clr-namespace:System.Windows.Forms.Integration;assembly=WindowsFormsIntegration"
        Title="Capturar firma"
        Width="520"
        Height="420"
        MinHeight="380"
        WindowStartupLocation="CenterOwner"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Surface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Accent}" Padding="16,12">
            <Grid>
                <TextBlock Text="Capturar firma (pad Topaz)"
                           Foreground="White"
                           FontSize="16"
                           FontWeight="SemiBold"
                           VerticalAlignment="Center" />
                <Button HorizontalAlignment="Right"
                        Content="✕"
                        Style="{StaticResource DialogCloseButton}"
                        Click="CloseButton_Click" />
            </Grid>
        </Border>

        <Border Grid.Row="1"
                Background="#F1F5F9"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="16,10">
            <Grid>
                <TextBlock x:Name="DeviceText"
                           Text="Dispositivo: —"
                           VerticalAlignment="Center"
                           Foreground="{StaticResource Brush.Muted}" />
                <Button HorizontalAlignment="Right"
                        Content="Limpiar"
                        Padding="12,6"
                        Style="{StaticResource SecondaryButton}"
                        Click="Clear_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="2" Margin="16,8,16,8">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto" />
                <RowDefinition Height="*" />
            </Grid.RowDefinitions>

            <Border x:Name="TopazPanel"
                    Grid.Row="0"
                    Margin="0,0,0,10"
                    Padding="12,10"
                    Background="#F8FAFC"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Visibility="Collapsed">
                <Grid>
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="1" />
                    </Grid.RowDefinitions>
                    <TextBlock x:Name="TopazHintText"
                               Grid.Row="0"
                               TextWrapping="Wrap"
                               Foreground="{StaticResource Brush.Muted}"
                               Margin="0,0,0,8" />
                    <StackPanel Grid.Row="1" Orientation="Horizontal">
                        <Button x:Name="TopazActivateButton"
                                Content="Activar pad Topaz"
                                MinWidth="140"
                                Margin="0,0,8,0"
                                Style="{StaticResource SecondaryButton}"
                                Click="TopazActivate_Click" />
                        <Button x:Name="TopazImportButton"
                                Content="Importar firma del pad"
                                MinWidth="170"
                                IsEnabled="False"
                                Style="{StaticResource SecondaryButton}"
                                Click="TopazImport_Click" />
                    </StackPanel>
                    <wfi:WindowsFormsHost x:Name="SigPlusHost"
                                          Grid.Row="2"
                                          Width="1"
                                          Height="1"
                                          HorizontalAlignment="Left"
                                          VerticalAlignment="Top"
                                          Visibility="Hidden" />
                </Grid>
            </Border>

            <Border Grid.Row="1"
                    BorderBrush="{StaticResource Brush.Border}"
                    BorderThickness="1"
                    CornerRadius="6"
                    Background="White"
                    MinHeight="200">
                <Grid>
                    <TextBlock x:Name="PreviewPlaceholder"
                               Text="La vista previa de la firma aparecerá aquí después de pulsar «Importar firma del pad»."
                               TextWrapping="Wrap"
                               TextAlignment="Center"
                               VerticalAlignment="Center"
                               Margin="24"
                               Foreground="{StaticResource Brush.Muted}" />
                    <Border HorizontalAlignment="Center"
                            VerticalAlignment="Center"
                            Padding="16"
                            x:Name="TopazPreviewBorder"
                            Visibility="Collapsed">
                        <StackPanel>
                            <TextBlock Text="Vista previa"
                                       FontSize="11"
                                       Foreground="{StaticResource Brush.Muted}"
                                       Margin="0,0,0,8"
                                       HorizontalAlignment="Center" />
                            <Image x:Name="TopazPreviewImage"
                                   MaxWidth="360"
                                   MaxHeight="160"
                                   Stretch="Uniform" />
                        </StackPanel>
                    </Border>
                </Grid>
            </Border>
        </Grid>

        <StackPanel Grid.Row="3"
                    Margin="16,0,16,16"
                    HorizontalAlignment="Right"
                    Orientation="Horizontal">
            <Button Content="Cancelar"
                    MinWidth="110"
                    IsCancel="True"
                    Click="Cancel_Click"
                    Style="{StaticResource SecondaryButton}" />
            <Button x:Name="SaveButton"
                    Content="Guardar firma"
                    MinWidth="120"
                    IsEnabled="False"
                    Click="Save_Click" />
        </StackPanel>
    </Grid>
</Window>
