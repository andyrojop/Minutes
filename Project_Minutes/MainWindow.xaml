<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Project_Minutes.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:models="clr-namespace:Project_Minutes.Models"
        Title="Minutas y firmas"
        Width="1040"
        Height="720"
        MinWidth="880"
        MinHeight="560"
        WindowStartupLocation="CenterScreen">
    <DockPanel Background="{StaticResource Brush.Surface}">
        <Menu DockPanel.Dock="Top" Padding="12,8,12,0">
            <MenuItem Header="_Archivo">
                <MenuItem Header="Gestionar _usuarios…" Click="MenuUsers_Click" />
                <Separator />
                <MenuItem Header="_Probar conexión a SQL" Click="ReconnectButton_Click" />
            </MenuItem>
        </Menu>

        <Border DockPanel.Dock="Top"
                Background="{StaticResource Brush.Card}"
                BorderBrush="{StaticResource Brush.Border}"
                BorderThickness="0,0,0,1"
                Padding="20,14">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="Auto" />
                </Grid.ColumnDefinitions>
                <StackPanel>
                    <TextBlock Text="Minutas y firmas"
                               FontSize="22"
                               FontWeight="SemiBold"
                               Foreground="{StaticResource Brush.Text}" />
                    <TextBlock x:Name="StatusText"
                               Margin="0,4,0,0"
                               FontSize="12"
                               Foreground="{StaticResource Brush.Muted}"
                               Text="Comprobando conexión…" />
                </StackPanel>
            </Grid>
        </Border>

        <StatusBar DockPanel.Dock="Bottom" Background="{StaticResource Brush.Card}" Padding="12,6">
            <StatusBarItem>
                <TextBlock x:Name="DataPathText"
                           FontSize="11"
                           Foreground="{StaticResource Brush.Muted}"
                           Text="Datos guardados en: —" />
            </StatusBarItem>
        </StatusBar>

        <TabControl Margin="16,8,16,12" x:Name="MainTabs">
            <!-- Reuniones -->
            <TabItem Header="Reuniones">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <ListBox x:Name="MeetingsList"
                             Grid.Row="0"
                             Style="{StaticResource CardListBox}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <TextBlock Text="{Binding Line}"
                                           TextWrapping="Wrap"
                                           FontSize="14"
                                           Foreground="{StaticResource Brush.Text}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="1"
                            Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Nueva reunión"
                                    Click="NewMeeting_Click"
                                    Style="{StaticResource OutlineAccentButton}" />
                            <Button Content="Editar" Click="EditMeeting_Click" Style="{StaticResource SecondaryButton}" />
                            <Button Content="Eliminar" Click="DeleteMeeting_Click" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Participantes -->
            <TabItem Header="Participantes">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Reunión"
                                   Foreground="{StaticResource Brush.Muted}"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="ParticipantMeetingCombo"
                                  DisplayMemberPath="DisplayText"
                                  MinWidth="360"
                                  SelectionChanged="ParticipantMeetingCombo_SelectionChanged" />
                        <TextBlock Margin="0,8,0,0"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.Muted}"
                                   TextWrapping="Wrap"
                                   Text="Los participantes son los asistentes que podrán firmar la minuta de esta reunión." />
                    </StackPanel>
                    <ListBox x:Name="ParticipantsList"
                             Grid.Row="1"
                             Style="{StaticResource CardListBox}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:ParticipantRecord}">
                                <TextBlock FontSize="14"
                                           Foreground="{StaticResource Brush.Text}"
                                           Text="{Binding ListCaption}" />
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,12,0,0">
                        <StackPanel>
                            <TextBlock Text="Registrar participante (nombre y puesto)"
                                       Foreground="{StaticResource Brush.Muted}"
                                       Margin="0,0,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="*" />
                                </Grid.ColumnDefinitions>
                                <StackPanel Grid.Column="0" Margin="0,0,8,0">
                                    <TextBlock Text="Nombre del participante"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Muted}"
                                               Margin="0,0,0,4" />
                                    <TextBox x:Name="NewParticipantNameBox"
                                             Padding="8,6"
                                             MinHeight="32"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                                <StackPanel Grid.Column="1" Margin="8,0,0,0">
                                    <TextBlock Text="Puesto del participante"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Muted}"
                                               Margin="0,0,0,4" />
                                    <TextBox x:Name="NewParticipantPositionBox"
                                             Padding="8,6"
                                             MinHeight="32"
                                             VerticalContentAlignment="Center" />
                                </StackPanel>
                            </Grid>
                            <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                <Button Content="Registrar con nombre y puesto"
                                        Click="RegisterNewParticipant_Click"
                                        Style="{StaticResource OutlineAccentButton}" />
                                <Button Content="Quitar seleccionado"
                                        Click="RemoveParticipant_Click"
                                        Style="{StaticResource SecondaryButton}" />
                            </StackPanel>
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Minutas -->
            <TabItem Header="Minutas">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Filtrar por reunión"
                                   Foreground="{StaticResource Brush.Muted}"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="MinuteFilterCombo"
                                  DisplayMemberPath="DisplayText"
                                  MinWidth="280"
                                  SelectionChanged="MinuteFilterCombo_SelectionChanged" />
                    </StackPanel>
                    <ListBox x:Name="MinutesList"
                             Grid.Row="1"
                             Style="{StaticResource CardListBox}"
                             SelectionMode="Single">
                        <ListBox.ItemTemplate>
                            <DataTemplate>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayLine}"
                                               TextWrapping="Wrap"
                                               FontSize="14"
                                               Foreground="{StaticResource Brush.Text}" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="11"
                                               Foreground="{StaticResource Brush.Muted}"
                                               Text="{Binding CreatedAt, StringFormat=Registrada: {0:g}}" />
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Nueva minuta"
                                    Click="NewMinute_Click"
                                    Style="{StaticResource OutlineAccentButton}" />
                            <Button Content="Editar" Click="EditMinute_Click" Style="{StaticResource SecondaryButton}" />
                            <Button Content="Eliminar" Click="DeleteMinute_Click" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>

            <!-- Compromisos -->
            <TabItem Header="Compromisos">
                <Grid Margin="0,12,0,0">
                    <Grid.RowDefinitions>
                        <RowDefinition Height="Auto" />
                        <RowDefinition Height="*" />
                        <RowDefinition Height="Auto" />
                    </Grid.RowDefinitions>
                    <StackPanel Grid.Row="0" Margin="0,0,0,12">
                        <TextBlock Text="Minuta"
                                   Foreground="{StaticResource Brush.Muted}"
                                   Margin="0,0,0,6" />
                        <ComboBox x:Name="TaskMinuteCombo"
                                  DisplayMemberPath="DisplayText"
                                  MinWidth="320"
                                  SelectionChanged="TaskMinuteCombo_SelectionChanged" />
                    </StackPanel>
                    <ListBox x:Name="TasksList"
                             Grid.Row="1"
                             Style="{StaticResource CardListBox}">
                        <ListBox.ItemTemplate>
                            <DataTemplate DataType="{x:Type models:TaskRecord}">
                                <StackPanel>
                                    <TextBlock FontWeight="SemiBold"
                                               FontSize="14"
                                               Text="{Binding Title}" />
                                    <TextBlock Margin="0,4,0,0"
                                               FontSize="12"
                                               Foreground="{StaticResource Brush.Muted}"
                                               Text="{Binding ResponsibleName, TargetNullValue=Sin responsable}" />
                                    <TextBlock FontSize="11"
                                               Foreground="{StaticResource Brush.Muted}"
                                               Text="{Binding DueDate, StringFormat=Fecha límite: {0:d}, TargetNullValue=Sin fecha límite}" />
                                    <TextBlock Margin="0,6,0,0"
                                               FontSize="12"
                                               FontWeight="SemiBold">
                                        <TextBlock.Style>
                                            <Style TargetType="TextBlock">
                                                <Setter Property="Text"
                                                        Value="✓ Responsable firmó (acepta responsabilidad)" />
                                                <Setter Property="Foreground" Value="#0F766E" />
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding HasResponsibleSignature}" Value="False">
                                                        <Setter Property="Text"
                                                                Value="⚠ Falta firma del responsable" />
                                                        <Setter Property="Foreground"
                                                                Value="#B45309" />
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </TextBlock.Style>
                                    </TextBlock>
                                </StackPanel>
                            </DataTemplate>
                        </ListBox.ItemTemplate>
                    </ListBox>
                    <Border Grid.Row="2"
                            Background="{StaticResource Brush.Card}"
                            BorderBrush="{StaticResource Brush.Border}"
                            BorderThickness="0,1,0,0"
                            Padding="0,12,0,0"
                            Margin="0,12,0,0">
                        <StackPanel Orientation="Horizontal">
                            <Button Content="Nuevo compromiso"
                                    Click="NewTask_Click"
                                    Style="{StaticResource OutlineAccentButton}" />
                            <Button Content="Firma del responsable…"
                                    Click="SignTask_Click"
                                    ToolTip="Solo el responsable asignado puede firmar y asumir el compromiso." />
                            <Button Content="Eliminar" Click="DeleteTask_Click" Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </Border>
                </Grid>
            </TabItem>
        </TabControl>
    </DockPanel>
</Window>
