<?xml version="1.0" encoding="utf-8"?>
<Window x:Class="Project_Minutes.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Acceso — Minutas y firmas"
        Width="480"
        SizeToContent="Height"
        MinHeight="400"
        WindowStartupLocation="CenterScreen"
        ResizeMode="NoResize"
        Background="{StaticResource Brush.Surface}">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
        </Grid.RowDefinitions>

        <Border Grid.Row="0" Background="{StaticResource Brush.Accent}" Padding="16,14">
            <TextBlock Text="Administradores"
                       Foreground="White"
                       FontSize="18"
                       FontWeight="SemiBold" />
        </Border>

        <ScrollViewer Grid.Row="1"
                      VerticalScrollBarVisibility="Auto"
                      Padding="20,18,20,18">
            <StackPanel>
                <TextBlock x:Name="StatusBanner"
                           TextWrapping="Wrap"
                           Margin="0,0,0,14"
                           FontSize="12"
                           Foreground="{StaticResource Brush.Muted}"
                           Text="Comprobando base de datos…" />

                <!-- Inicio de sesión (visible si ya hay administradores) -->
                <Border x:Name="LoginSection"
                        Style="{StaticResource PanelCard}"
                        Padding="16,14"
                        Margin="0,0,0,14"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="INICIO DE SESIÓN"
                                   Margin="0,0,0,10" />
                        <TextBlock Text="Usuario"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.Muted}"
                                   Margin="0,0,0,4" />
                        <TextBox x:Name="UsernameBox"
                                 Padding="8,6"
                                 MinHeight="32"
                                 VerticalContentAlignment="Center" />
                        <TextBlock Text="Contraseña"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.Muted}"
                                   Margin="0,12,0,4" />
                        <PasswordBox x:Name="PasswordBox"
                                     Padding="8,6"
                                     MinHeight="32"
                                     VerticalContentAlignment="Center" />
                        <StackPanel Orientation="Horizontal" Margin="0,16,0,0">
                            <Button x:Name="LoginButton"
                                    Content="Iniciar sesión"
                                    IsDefault="True"
                                    Click="LoginButton_Click"
                                    Style="{StaticResource OutlineAccentButton}" />
                            <Button Content="Salir"
                                    Margin="10,0,0,0"
                                    Click="ExitButton_Click"
                                    Style="{StaticResource SecondaryButton}" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <!-- Registro de administrador (siempre que haya conexión a BD) -->
                <Border x:Name="RegisterSection"
                        Style="{StaticResource InsetPanel}"
                        Padding="16,14"
                        Margin="0,0,0,12"
                        Visibility="Collapsed">
                    <StackPanel>
                        <TextBlock Style="{StaticResource SectionTitle}"
                                   Text="REGISTRO DE ADMINISTRADOR"
                                   Margin="0,0,0,8" />
                        <TextBlock x:Name="RegisterHelpText"
                                   TextWrapping="Wrap"
                                   FontSize="12"
                                   Foreground="{StaticResource Brush.Muted}"
                                   Margin="0,0,0,12"
                                   Text="" />
                        <StackPanel Orientation="Horizontal">
                            <Button x:Name="RegisterFirstButton"
                                    Content="Crear primer administrador"
                                    Click="RegisterFirstButton_Click"
                                    Style="{StaticResource OutlineAccentButton}"
                                    Visibility="Collapsed" />
                            <Button x:Name="RegisterAdditionalButton"
                                    Content="Registrar otro administrador…"
                                    Click="RegisterAdditionalButton_Click"
                                    Style="{StaticResource OutlineAccentButton}"
                                    Visibility="Collapsed" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Button x:Name="ExitOnlyButton"
                        Visibility="Collapsed"
                        HorizontalAlignment="Left"
                        Content="Salir"
                        Click="ExitButton_Click"
                        Style="{StaticResource SecondaryButton}" />
            </StackPanel>
        </ScrollViewer>
    </Grid>
</Window>
